{
  "manifest_version": 3,
  "name": "Realloc \u2014 PR LOC Breakdown",
  "version": "0.2.0",
  "description": "Breaks out added/removed lines in Bitbucket and GitHub PRs: test files, docs, comments, and code.",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://bitbucket.org/*/pull-requests/*",
        "*://github.com/*/*/pull/*"
      ],
      "js": [
        "src/languages.js",
        "src/parser.js",
        "src/cache.js",
        "src/net.js",
        "src/providers/bitbucket.js",
        "src/providers/github.js",
        "src/providers/index.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://bitbucket.org/*",
    "https://github.com/*",
    "https://patch-diff.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
